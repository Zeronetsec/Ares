# https://github.com/Zeronetsec/Ares

function lib::shell::libso::free() {
    enable -f \
        "${__lib__}/shell/libso/destroyso.so" \
        destroyso || \
        return 1

    builtin destroyso : '(
        destroyf
        destroyv
        include
        loadso
        rhome
        dynav
        dynap
        shmod
        catchypr
        unreadonlyf
        unreadonlyv
        error
        llsi
        loadrc
    )' || return 1

    enable -d destroyso || return 1

    trap - ERR
    set -o errexit
}; readonly -f lib::shell::libso::free; export -f lib::shell::libso::free

