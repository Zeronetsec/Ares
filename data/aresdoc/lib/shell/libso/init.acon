    {color.R}- {color.GG}destroyf{color.N}
    {color.R}- {color.GG}destroyso{color.N}
    {color.R}- {color.GG}destroyv{color.N}
    {color.R}- {color.GG}dynap{color.N}
    {color.R}- {color.GG}dynav{color.N}
    {color.R}- {color.GG}error{color.N}
    {color.R}- {color.GG}include{color.N}
